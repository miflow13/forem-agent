# Public research does not require an API key.
FOREM_BASE_URL=https://dev.to/api

# Local state and editable Markdown article projects.
# FOREM_AGENT_HOME=.forem-agent
# FOREM_AGENT_WORKSPACE=articles

# Optional. Required for authenticated author history and later draft push.
# Keep credentials in environment variables only.
FOREM_API_KEY=

# Recommended: launch `meldr` and use first-run AI setup.
# meldr writes these values to the local, gitignored .env file.
#
# Supported providers:
#   openai
#   anthropic
#   openai-compatible  (must implement the OpenAI Responses API)
#
# MELDR_MODEL_PROVIDER=openai
# MELDR_MODEL_API_KEY=
# MELDR_MODEL=gpt-5.6
# MELDR_MODEL_BASE_URL=https://api.openai.com/v1

# Backward-compatible provider-specific variables are also recognized when
# MELDR_MODEL_PROVIDER is not set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
