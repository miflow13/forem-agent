# Public research does not require an API key.
FOREM_BASE_URL=https://dev.to/api

# Optional. Required for authenticated author history and later draft push.
# Keep credentials in environment variables only.
FOREM_API_KEY=

# Optional model interpreter. The model receives bounded evidence packets only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1
