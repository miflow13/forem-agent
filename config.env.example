# meldr reads settings from the process environment and from
#   $MELDR_HOME/config.env
# where MELDR_HOME defaults to $XDG_CONFIG_HOME/meldr, else ~/.config/meldr.
# It does not read .env from the directory you run it in.
#
# Recommended: launch `meldr` and use first-run AI setup, which writes the
# AI values below to config.env with owner-only permissions.
#
# MELDR_HOME itself must be set in the environment, not in this file.

# Public research does not require an API key.
FOREM_BASE_URL=https://dev.to/api

# Editable Markdown article projects (default: ./articles).
# FOREM_AGENT_WORKSPACE is still accepted as an older name.
# MELDR_WORKSPACE=articles

# Optional. Required for authenticated author history and later draft push.
FOREM_API_KEY=

# Supported providers:
#   openai
#   anthropic
#   openai-compatible  (must implement the OpenAI Responses API)
#
# MELDR_MODEL_PROVIDER=openai
# MELDR_MODEL_API_KEY=
# MELDR_MODEL=gpt-5.6
# MELDR_MODEL_BASE_URL=https://api.openai.com/v1

# Backward-compatible provider-specific variables are also recognized when
# MELDR_MODEL_PROVIDER is not set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
